classDiagram
    class Form {
        +String name
        +String slug
        +FormStatus status
        +FormField[] fields
        +FormSettings settings
        +FormAnalytics analytics
        +VersionEntry[] versions
    }
    class FormField {
        +String id
        +FormFieldType type
        +String label
        +Boolean required
        +Validation validation
        +String width
        +Number order
        +Mixed[] conditionalRules
        +Option[] options
        +Number step
    }
    class FormSettings {
        +MultiStep multiStep
        +Notifications notifications
        +Webhook webhook
        +Spam spam
        +FileUpload fileUpload
    }
    class FormAnalytics {
        +Number views
        +Number starts
        +Number completions
        +Number conversionRate
        +Mixed dropOffByField
        +TimelinePoint[] timeline
    }
    Form "1" *-- "many" FormField : embeds
    Form "1" *-- "1" FormSettings : embeds
    Form "1" *-- "1" FormAnalytics : embeds
    FormField "1" *-- "0..1" Validation
    FormField "1" *-- "many" Option
    FormSettings *-- Webhook
    FormSettings *-- Spam
    FormAnalytics *-- TimelinePoint
