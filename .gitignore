# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/public/upload
/public/siteicon
# Layout planner training artifacts (schema + scripts + fixtures + briefs stay tracked)
training/data/raw/
training/data/validated/
training/outputs/
training/layout-planner/outputs/
# Python bytecode from the training scripts
training/**/__pycache__/
*.pyc

